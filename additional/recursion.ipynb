   "source": [
    "def print_sum(n):\n",
    "\n",
    "    s=0\n",
    "\n",
    "    for i in range(n+1):\n",
    "        s+=i\n",
    "    \n",
    "    print(s)\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "print_sum(3)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Recursive:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "15\n"
     ]
    }
   ],
   "source": [
    "def print_sum(n):\n",
    "\n",
    "    if n==1:\n",
    "        return 1\n",
    "    \n",
    "    s=n+print_sum(n-1)\n",
    "\n",
    "    return s\n",
    "\n",
    "    \n",
    "   \n",
    "\n",
    "\n",
    "\n",
    "print(print_sum(5))\n"
   ]
  }
